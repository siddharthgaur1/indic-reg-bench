# Fetched source documents are NOT redistributed from this repo.
# Rebuild locally with: python scripts/fetch_orders.py
data/*.db
data/pdfs/

# Scratch copies of order text written by scripts/label.py for searching.
# Same reason as above: order text stays local.
labels/.reading/

# Evaluation sets built by scripts/build_eval_set.py. Each record embeds the
# full order text next to its label - that is what `evaluate` needs, and
# exactly what this repo does not redistribute. The *_ids.json lists beside
# them carry no text and stay tracked. Rebuild the rest locally.
data/splits/*/
predictions/.run.log

__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.env
.pytest_cache/
.ruff_cache/
